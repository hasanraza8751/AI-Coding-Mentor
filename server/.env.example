# Copy to `.env` and adjust as needed.
# The extension defaults to http://localhost:3000 — keep PORT in sync.
PORT=3000

# Mentor provider: "ollama" (default) or "mock".
# Use "mock" for UI testing without Ollama running.
MENTOR_PROVIDER=ollama

# Ollama connection (Milestone 3). No hardcoding elsewhere:
# the service reads these values via src/config.ts.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_MS=120000

# Max stored chat messages (user + assistant combined) sent back
# to the model as short-term context. In-memory only, no persistence.
CONVERSATION_HISTORY_LIMIT=20
